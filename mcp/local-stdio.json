{
  "mcpServers": {
    "apify": {
      "command": "npx",
      "args": [
        "-y", "@apify/actors-mcp-server@latest",
        "--tools", "actors,vncntlabs/keyword-search-volume,vncntlabs/domain-seo-data,vncntlabs/google-trends-search-volume"
      ],
      "env": {
        "APIFY_TOKEN": "your_apify_token_here"
      }
    }
  }
}
